<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HCBridge" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Card">
        <item name="android:background">@drawable/card_bg</item>
        <item name="android:padding">18dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <style name="ValueText">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CaptionText">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_marginTop">4dp</item>
    </style>

    <style name="LabelText">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="PrimaryButton" parent="android:Widget.Material.Button">
        <item name="android:backgroundTint">@color/brand</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <style name="SecondaryButton" parent="android:Widget.Material.Button.Borderless">
        <item name="android:textColor">@color/brand</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>
